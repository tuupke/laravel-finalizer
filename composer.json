{
    "name": "tuupke/laravel-finalizer",
    "description": "Simple package with helpers to handle execution after closed connections",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Mart Pluijmaekers",
            "email": "mart@tuupke.nl"
        }
    ],
    "minimum-stability": "stable",
    "require": {
        "php": "^7.4 || ^8.0",
        "illuminate/support": "^6.0 || ^7.0 || ^8.0 || ^9.0 || ^10.0 || ^11.0 || ^12.0 || ^13.0"
    },
    "autoload": {
        "psr-4": {
            "Tuupke\\Finalizer\\": "src"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Tuupke\\Finalizer\\FinalizerServiceProvider"
            ],
            "aliases": {
                "Finalizer": "Tuupke\\Finalizer\\FinalizerFacade"
            }
        }
    }
}

